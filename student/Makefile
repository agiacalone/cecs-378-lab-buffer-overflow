.PHONY: briefing print-seed help

briefing print-seed:
	@$(MAKE) -C ../build $@

help:
	@echo "Targets (from this directory):"
	@echo "  make briefing      first-time setup; prompts for your handle"
	@echo "  make print-seed    show your seed fingerprint"
	@echo
	@echo "Compile your exploits with the gcc command shown in WRITEUP.md"
	@echo "(or run 'man phase-phi' / 'man phase-omega')."
